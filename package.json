{
  "name": "awesome-config",
  "description": "An opinionated TypeScript development configuration.",
  "keywords": [
    "config",
    "tooling",
    "typescript"
  ],
  "homepage": "https://github.com/DanhezCode/awesome-config#readme",
  "bugs": {
    "url": "https://github.com/DanhezCode/awesome-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel A. Hernández Ochoa",
    "url": "https://github.com/DanhezCode"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanhezCode/awesome-config.git"
  },
  "files": [
    "dist",
    "lefthook.yml",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "exports": {
    "./commitlint.config": "./dist/commitlint.config.mjs",
    "./cspell.config": "./dist/cspell.config.mjs",
    "./oxfmt.config": "./dist/oxfmt.config.mjs",
    "./oxlint.config": "./dist/oxlint.config.mjs",
    "./release.config": "./dist/release.config.mjs",
    "./package.json": "./package.json",
    "./lefthook.yml": "./lefthook.yml"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check . 1>/dev/null || oxfmt --check .",
    "fmt:fix": "oxfmt . 1>/dev/null || oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "tests": "vitest run",
    "tests:watch": "vitest",
    "tests:cov": "vitest run --coverage",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@cspell/dict-es-es": "3.0.8",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "devDependencies": {
    "@tsdown/css": "0.22.14",
    "@vitest/coverage-v8": "4.1.10",
    "tsdown": "0.22.14",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "bun": "1.3.14",
    "node": "26.7.0"
  },
  "packageManager": "bun@1.3.14"
}
