{
  "name": "awesome-config",
  "version": "0.1.0",
  "description": "A collection of editor and tool configurations, templates and best-practices for JavaScript/TypeScript projects.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --log-level=error --check .",
    "format:fix": "prettier --log-level=error --write .",
    "check:format:lint": "bun format:fix && bun lint:fix",
    "check:typecheck:format:lint": "bun run --parallel typecheck check:format:lint",
    "check:all": "bun check:typecheck:format:lint && bun tests",
    "tests": "bun vitest",
    "prepare": "lefthook install"
  },
  "devDependencies": {},
  "peerDependencies": {
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "tsdown": "^0.22.14"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.8.0",
    "eslint-config-preact": "^2.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.9.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.8"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanhezCode/awesome-config.git"
  },
  "homepage": "https://github.com/DanhezCode/awesome-config#readme",
  "bugs": {
    "url": "https://github.com/DanhezCode/awesome-config/issues"
  },
  "author": "DanhezCode",
  "license": "MIT",
  "keywords": [
    "config",
    "template",
    "eslint",
    "prettier",
    "typescript",
    "setup"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "**/*.config.*",
    "**/*.json",
    "**/*.yml"
  ],
  "publishConfig": {
    "access": "public"
  }
}
