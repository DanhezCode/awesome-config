{
  "name": "ts-template",
  "type": "module",
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check . 1>/dev/null || oxfmt --check .",
    "fmt:fix": "oxfmt . 1>/dev/null || oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "tests": "vitest run",
    "tests:watch": "vitest",
    "tests:cov": "vitest run --coverage",
    "postinstall": "lefthook install"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@cspell/dict-es-es": "3.0.8",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "cspell": "10.0.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {},
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
